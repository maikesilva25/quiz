{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "NODE_ENV": "production",
        "EXPO_USE_COMMUNITY_AUTOLINKING": "0"
      },
      "channel": "preview",
      "prebuildCommand": "npx expo prebuild --clean --platform android && node -e \"const fs=require('fs');const config='module.exports={project:{android:{packageName:\\'com.nossoapp.oracoes\\'}}};';fs.writeFileSync('react-native.config.js',config);\""
    },
    "production": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "NODE_ENV": "production"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}

